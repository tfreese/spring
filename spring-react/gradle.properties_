group = de.react.example
version = 0.0.1-SNAPSHOT
description = "React Example"

org.gradle.jvmargs = -Xms1024m -Xmx2048m -Djava.security.egd=file:/dev/./urandom -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 --sun-misc-unsafe-memory-access=allow --enable-native-access=ALL-UNNAMED
file.encoding = UTF-8

org.gradle.warning.mode = all

###################################################################################################
# https://react.dev/learn

# Updates in package.json.
# Suchen in https://www.npmjs.com/package nach:
# react
# react-dom
# vite
# @vitejs/plugin-react
# typescript
# @types/react
# @types/react-dom

# https://nodejs.org/dist/index.json
#G:A org.nodejs:node:26.11.1
version_node = 26.11.1

# https://github.com/node-gradle/gradle-node-plugin
# https://plugins.gradle.org/plugin/com.github.node-gradle.node
version_nodeGradlePlugin = 7.1.0

# https://registry.npmjs.org/npm
version_npm = 12.2.0

